# Copy outside the repository; replace every REPLACE value using secret management.
NODE_ENV=production
PORT=8402
HOST=127.0.0.1
ENABLED_NETWORKS=eip155:80002
CORS_ORIGINS=https://REPLACE-ec-origin.example
RELAYER_PRIVATE_KEY=REPLACE-legacy-relayer-key
RPC_URLS_80002=https://REPLACE-private-amoy-rpc.example
FACILITATOR_HMAC_KEYS=ec-to-fac:REPLACE-unique-32-byte-or-longer-secret

AGENT_COMMERCE_ENABLED=true
AGENT_DEPLOYMENT_MANIFEST=/secure/amoy-manifest.json
AGENT_RPC_URL=https://REPLACE-private-amoy-rpc.example
AGENT_RELAYER_PRIVATE_KEY=REPLACE-manifest-pinned-agent-relayer-key
AGENT_JOURNAL_PATH=/persistent/agent-journal.sqlite
AGENT_EC_ORIGIN=https://REPLACE-ec-origin.example
AGENT_EC_KEY_ID=fac-to-ec
AGENT_EC_HMAC_SECRET=REPLACE-a-different-32-byte-or-longer-secret
